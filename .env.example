# LocalMarché - Variables d'environnement
# Copier ce fichier en .env et compléter avec vos valeurs.
# Le fichier .env est listé dans .gitignore et ne doit JAMAIS être commité.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=localmarche
DB_USER=root
DB_PASS=

# Pour Railway (production), ces variables sont injectées automatiquement
# par la plateforme. En développement local, renseignez-les ici.
